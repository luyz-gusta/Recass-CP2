# ExpenseHub — requisições de validação (VS Code REST Client ou Visual Studio 2022 17.12+).
#
# As senhas NÃO ficam neste arquivo. Crie sources/ExpenseHub.Api/.env (ignorado pelo Git) com:
#   EXPENSEHUB_ADMIN_PASS=<a mesma senha configurada em AdminSeed:Password>
#   EXPENSEHUB_DEMO_PASS=<senha dos usuários de demonstração, na política do Identity>
# Veja a seção "Autenticação" do README.
#
# Ordem sugerida: execute as requisições de cima para baixo com o banco zerado.

@baseUrl = http://localhost:5245
@adminEmail = admin@expensehub.local
@adminPassword = {{$dotenv EXPENSEHUB_ADMIN_PASS}}
@demoPassword = {{$dotenv EXPENSEHUB_DEMO_PASS}}

### Saúde da API (rota pública) → 200
GET {{baseUrl}}/health
Accept: application/json

# ============================================================
# I02 — Identity, Admin e autenticação
# ============================================================

### Login do Admin → 200 com accessToken
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Usuário autenticado e roles do token → 200 com roles ["Admin"]
# @name meAdmin
GET {{baseUrl}}/api/me
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### Senha incorreta → 401 (ProblemDetails)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}-incorreta"
}

### E-mail inválido → 400
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "nao-e-email",
  "password": "{{adminPassword}}"
}

### Campo desconhecido no corpo → 400 (o cliente não envia roles)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "roles": ["Admin"]
}

### Rota protegida sem token → 401 (ProblemDetails)
GET {{baseUrl}}/api/me

### Rota protegida com token inválido → 401
GET {{baseUrl}}/api/me
Authorization: Bearer token-invalido

# ============================================================
# I03 — Cadastro HTTP e gerenciamento de roles
# ============================================================
# Usuários de demonstração (todos com {{demoPassword}}). O cadastro nunca recebe roles:
# o Admin atribui depois e cada usuário faz login de novo para receber as roles no token.

### Cadastro público → 201 sem roles
# @name registerFuncionario1
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "funcionario1@expensehub.local",
  "password": "{{demoPassword}}"
}

### Cadastro → 201
# @name registerFuncionario2
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "funcionario2@expensehub.local",
  "password": "{{demoPassword}}"
}

### Cadastro → 201
# @name registerAprovador
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "aprovador@expensehub.local",
  "password": "{{demoPassword}}"
}

### Cadastro → 201
# @name registerFinanceiro
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "financeiro@expensehub.local",
  "password": "{{demoPassword}}"
}

### Cadastro → 201
# @name registerAuditor
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "auditor@expensehub.local",
  "password": "{{demoPassword}}"
}

### Cadastro → 201 (receberá Approver + Employee)
# @name registerAprovadorFuncionario
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "aprovador.funcionario@expensehub.local",
  "password": "{{demoPassword}}"
}

### Cadastro → 201 (receberá Finance + Employee)
# @name registerFinanceiroFuncionario
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "financeiro.funcionario@expensehub.local",
  "password": "{{demoPassword}}"
}

### Cadastro tentando escolher a role → 400 (campo desconhecido)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "intruso@expensehub.local",
  "password": "{{demoPassword}}",
  "roles": ["Admin"]
}

### E-mail já cadastrado → 409
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "funcionario1@expensehub.local",
  "password": "{{demoPassword}}"
}

### Senha fora da política do Identity → 400 (mensagens em português)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "senha.fraca@expensehub.local",
  "password": "abcdefgh"
}

### Login de usuário ainda sem roles
# @name loginSemRole
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "funcionario1@expensehub.local",
  "password": "{{demoPassword}}"
}

### Listar usuários sem token → 401
GET {{baseUrl}}/api/admin/users

### Listar usuários com usuário sem role → 403
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{loginSemRole.response.body.$.accessToken}}

### Admin lista usuários e roles → 200
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### Admin atribui Employee → 200
PUT {{baseUrl}}/api/admin/users/{{registerFuncionario1.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Employee"] }

### Admin atribui Employee → 200
PUT {{baseUrl}}/api/admin/users/{{registerFuncionario2.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Employee"] }

### Admin atribui Approver → 200
PUT {{baseUrl}}/api/admin/users/{{registerAprovador.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Approver"] }

### Admin atribui Finance → 200
PUT {{baseUrl}}/api/admin/users/{{registerFinanceiro.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Finance"] }

### Admin atribui Auditor → 200
PUT {{baseUrl}}/api/admin/users/{{registerAuditor.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Auditor"] }

### Admin atribui Approver + Employee → 200
PUT {{baseUrl}}/api/admin/users/{{registerAprovadorFuncionario.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Approver", "Employee"] }

### Admin atribui Finance + Employee → 200
PUT {{baseUrl}}/api/admin/users/{{registerFinanceiroFuncionario.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Finance", "Employee"] }

### Role desconhecida → 400 (roles nunca são criadas implicitamente)
PUT {{baseUrl}}/api/admin/users/{{registerFuncionario1.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Employee", "Root"] }

### Usuário inexistente → 404
PUT {{baseUrl}}/api/admin/users/00000000-0000-0000-0000-000000000000/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Employee"] }

### Admin removendo a própria role Admin → 409
PUT {{baseUrl}}/api/admin/users/{{meAdmin.response.body.$.id}}/roles
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "roles": ["Employee"] }

### Token antigo continua sem roles: é preciso fazer login de novo → 200 com roles []
GET {{baseUrl}}/api/me
Authorization: Bearer {{loginSemRole.response.body.$.accessToken}}

# ------------------------------------------------------------
# Logins por perfil (execute depois de atribuir as roles).
# As seções de reembolsos reutilizam estes nomes.
# ------------------------------------------------------------

### Login Employee (funcionario1)
# @name loginFuncionario1
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "funcionario1@expensehub.local",
  "password": "{{demoPassword}}"
}

### Login Employee (funcionario2)
# @name loginFuncionario2
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "funcionario2@expensehub.local",
  "password": "{{demoPassword}}"
}

### Login Approver
# @name loginAprovador
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "aprovador@expensehub.local",
  "password": "{{demoPassword}}"
}

### Login Finance
# @name loginFinanceiro
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "financeiro@expensehub.local",
  "password": "{{demoPassword}}"
}

### Login Auditor
# @name loginAuditor
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "auditor@expensehub.local",
  "password": "{{demoPassword}}"
}

### Login Approver + Employee
# @name loginAprovadorFuncionario
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "aprovador.funcionario@expensehub.local",
  "password": "{{demoPassword}}"
}

### Login Finance + Employee
# @name loginFinanceiroFuncionario
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "financeiro.funcionario@expensehub.local",
  "password": "{{demoPassword}}"
}

### Após novo login, o token traz a role atribuída → 200 com roles ["Employee"]
GET {{baseUrl}}/api/me
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}

# ============================================================
# I04 — Reembolsos: rascunho (criar e editar)
# ============================================================
# Execute depois dos logins por perfil. O proprietário vem sempre do token: o corpo só tem
# description, amount, expenseDate (yyyy-MM-dd, nunca futura) e categoryId (1 a 5).

### Employee cria um rascunho → 201 (Draft, ownerId = funcionario1, Location /api/expenses/{id})
# @name criarReembolso
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Valor mínimo (0.01) → 201
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Estacionamento no aeroporto",
  "amount": 0.01,
  "expenseDate": "2026-09-16",
  "categoryId": 2
}

### Valor zero → 400 (Amount)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 0,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Valor abaixo de 0.01 → 400 (Amount)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 0.009,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Valor acima de Int32.MaxValue → 400 (Amount)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 2147483647.01,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Data futura → 400 (ExpenseDate)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2099-12-31",
  "categoryId": 1
}

### Descrição curta (menos de 10 caracteres) → 400 (Description)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Táxi",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Categoria inexistente → 400 (CategoryId)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 99
}

### Campo obrigatório ausente (sem amount) → 400, nunca vira 0 em silêncio
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Cliente tentando definir o proprietário → 400 (campo desconhecido, sem mass assignment)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "ownerId": "{{registerFuncionario2.response.body.$.id}}",
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Cliente tentando definir o estado → 400 (campo desconhecido)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "status": "Approved",
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Sem token → 401
POST {{baseUrl}}/api/expenses
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Approver (sem Employee) tentando criar → 403
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginAprovador.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Auditor tentando criar → 403
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginAuditor.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Admin tentando criar → 403 (Admin não recebe acesso funcional)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente em São Paulo",
  "amount": 150.50,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Approver + Employee cria o próprio rascunho → 201 (ownerId = aprovador.funcionario)
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginAprovadorFuncionario.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Passagem de metrô para o cliente",
  "amount": 12.40,
  "expenseDate": "2026-09-17",
  "categoryId": 2
}

### O proprietário edita o rascunho → 200 (updatedAtUtc novo; histórico Updated com as alterações)
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente e equipe em São Paulo",
  "amount": 210.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Mesmos dados de novo → 200 sem alteração (nenhum histórico novo, updatedAtUtc igual)
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente e equipe em São Paulo",
  "amount": 210.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Edição com valor inválido → 400
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente e equipe em São Paulo",
  "amount": 0,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Edição tentando trocar o proprietário → 400 (campo desconhecido)
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "ownerId": "outro-usuario",
  "description": "Almoço com cliente e equipe em São Paulo",
  "amount": 210.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Outro Employee editando o rascunho de funcionario1 → 404 (não revela que existe)
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFuncionario2.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Tentativa de alterar o rascunho alheio",
  "amount": 1.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Approver + Employee editando o rascunho de funcionario1 → 404 (acumular roles não dá acesso)
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginAprovadorFuncionario.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Tentativa de alterar o rascunho alheio",
  "amount": 1.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Approver (sem Employee) editando → 403
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginAprovador.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente e equipe em São Paulo",
  "amount": 210.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Edição de reembolso inexistente → 404
PUT {{baseUrl}}/api/expenses/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Almoço com cliente e equipe em São Paulo",
  "amount": 210.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Edição sem token → 401
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Content-Type: application/json

{
  "description": "Almoço com cliente e equipe em São Paulo",
  "amount": 210.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

# ============================================================
# I05 — Reembolsos: enviar, listar e consultar
# ============================================================
# Usa o reembolso "criarReembolso" (Draft de funcionario1) da seção I04.

### funcionario2 cria o próprio rascunho → 201 (usado nas listagens)
# @name criarReembolsoFuncionario2
POST {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario2.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Hospedagem durante a conferência",
  "amount": 890.00,
  "expenseDate": "2026-09-20",
  "categoryId": 3
}

### Outro Employee tentando enviar o rascunho de funcionario1 → 404
POST {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}/submit
Authorization: Bearer {{loginFuncionario2.response.body.$.accessToken}}

### Approver + Employee tentando enviar o rascunho de funcionario1 → 404 (acumular roles não dá acesso)
POST {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}/submit
Authorization: Bearer {{loginAprovadorFuncionario.response.body.$.accessToken}}

### Approver (sem Employee) tentando enviar → 403
POST {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}/submit
Authorization: Bearer {{loginAprovador.response.body.$.accessToken}}

### Auditor tentando enviar → 403 (Auditor não escreve)
POST {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}/submit
Authorization: Bearer {{loginAuditor.response.body.$.accessToken}}

### Admin tentando enviar → 403
POST {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}/submit
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### Envio sem token → 401
POST {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}/submit

### Envio de reembolso inexistente → 404
POST {{baseUrl}}/api/expenses/00000000-0000-0000-0000-000000000000/submit
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}

### O proprietário envia o rascunho → 200 (status Submitted, submittedAtUtc preenchido)
POST {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}/submit
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}

### Reenvio do mesmo reembolso → 409 (sem histórico duplicado)
POST {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}/submit
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}

### Edição depois do envio → 409
PUT {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}
Content-Type: application/json

{
  "description": "Tentativa de editar depois de enviar",
  "amount": 1.00,
  "expenseDate": "2026-09-15",
  "categoryId": 1
}

### Listagem do Employee → 200 somente com os reembolsos de funcionario1
GET {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}

### Listagem do outro Employee → 200 somente com os de funcionario2 (nenhum de funcionario1)
GET {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFuncionario2.response.body.$.accessToken}}

### Listagem do Approver → 200 somente com os Submitted (nenhum Draft)
GET {{baseUrl}}/api/expenses
Authorization: Bearer {{loginAprovador.response.body.$.accessToken}}

### Listagem do Approver + Employee → 200 com os próprios mais os Submitted
GET {{baseUrl}}/api/expenses
Authorization: Bearer {{loginAprovadorFuncionario.response.body.$.accessToken}}

### Listagem do Finance → 200 [] (ainda não há Approved nem Paid)
GET {{baseUrl}}/api/expenses
Authorization: Bearer {{loginFinanceiro.response.body.$.accessToken}}

### Listagem do Auditor → 200 com todos os reembolsos
GET {{baseUrl}}/api/expenses
Authorization: Bearer {{loginAuditor.response.body.$.accessToken}}

### Listagem do Admin → 403 (Admin não recebe acesso funcional)
GET {{baseUrl}}/api/expenses
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}

### Listagem com token antigo, sem roles → 403
GET {{baseUrl}}/api/expenses
Authorization: Bearer {{loginSemRole.response.body.$.accessToken}}

### Listagem sem token → 401
GET {{baseUrl}}/api/expenses

### O proprietário consulta o detalhe → 200
GET {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFuncionario1.response.body.$.accessToken}}

### Trocar o id na URL por um reembolso de outro Employee → 404
GET {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFuncionario2.response.body.$.accessToken}}

### Approver consulta um Submitted → 200
GET {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginAprovador.response.body.$.accessToken}}

### Approver consulta o Draft de funcionario2 → 404 (não revela que existe)
GET {{baseUrl}}/api/expenses/{{criarReembolsoFuncionario2.response.body.$.id}}
Authorization: Bearer {{loginAprovador.response.body.$.accessToken}}

### Finance consulta um Submitted → 404 (só vê Approved e Paid)
GET {{baseUrl}}/api/expenses/{{criarReembolso.response.body.$.id}}
Authorization: Bearer {{loginFinanceiro.response.body.$.accessToken}}

### Auditor consulta qualquer reembolso, inclusive Draft alheio → 200
